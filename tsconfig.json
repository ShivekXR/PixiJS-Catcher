{
    "compilerOptions": {
        // Compiler
        "module": "ESNext",
        "target": "ES6",
        "sourceMap": true,
        
        // Code check
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        
        // Module resolving
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        
        // Paths
        "baseUrl": ".",
        "paths": {
            "*": [
                "scripts/*",
                "scripts/Core/*",
                "scripts/Core/AssetsBundles/*",
                "scripts/Core/ComponentSystem/*",
                "scripts/Core/ContainerComponentSystem/*",
                "scripts/Core/Misc/*",
                "scripts/Gameplay/*",
            ],
        },
    }
}